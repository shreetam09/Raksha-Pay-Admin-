{
  "name": "workspace",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "lib/integrations/*",
    "scripts",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@workspace/rakshapay-admin",
    "dev:admin": "npm run dev --workspace=@workspace/rakshapay-admin",
    "dev:api": "npm run dev --workspace=@workspace/api-server",
    "dev:sandbox": "npm run dev --workspace=@workspace/mockup-sandbox",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces --if-present"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
